{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/config.js",
      "destination": "/gallery/api/config.js"
    },
    {
      "source": "/css/:path*",
      "destination": "/gallery/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/gallery/js/:path*"
    },
    {
      "source": "/gallery/:path*",
      "destination": "/gallery/index.html"
    },
    {
      "source": "/",
      "destination": "/gallery/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
