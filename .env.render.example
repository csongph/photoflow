# Render web service variables. Do not commit real secrets.

DATABASE_URL=<Supabase Postgres connection string>
PUBLIC_GALLERY_BASE_URL=https://your-vercel-project.vercel.app/gallery
CLOUD_SYNC_TOKEN=copy-the-generated-token-from-render

# Optional. Usually not needed on cloud because local uploads to Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
